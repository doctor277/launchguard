# Optional Compose overrides. Copy to .env; do not commit your .env.
# Optional image/OCI metadata. set-build-metadata.ps1 populates these from HEAD for pipeline builds.
APP_VERSION=0.7.0-SNAPSHOT
IMAGE_PREFIX=launchguard
IMAGE_TAG=0.7.0-SNAPSHOT
GIT_SHA=unknown
BUILD_TIMESTAMP=unknown
# Use POSTGRES_PORT=5433 if a host PostgreSQL already occupies 5432.
POSTGRES_PORT=5432
LAUNCHGUARD_PORT=8080
PAYMENT_PORT=8081
ORDER_PORT=8082
NOTIFICATION_PORT=8083
KAFKA_PORT=9092
PROBE_WORKER_PORT=8084

# Keep consumer concurrency >= partitions for independent partition progress.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_CONSUMER_CONCURRENCY=6
PROBE_WORKER_THREADS=4
PROBE_WORKER_QUEUE_CAPACITY=64
PROBE_IN_FLIGHT_TTL=120s

# Compose lab defaults; direct Java execution defaults to 30s.
MONITORING_INTERVAL=5s
MONITORING_INITIAL_DELAY=5s
MONITORING_CONNECT_TIMEOUT=2s
MONITORING_RESPONSE_TIMEOUT=5s
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_RECOVERY_THRESHOLD=2

# Used by POST /admin/slow without a delayMs query argument (1..30000 ms).
PAYMENT_SLOW_DELAY_MS=2000
ORDER_SLOW_DELAY_MS=2000
NOTIFICATION_SLOW_DELAY_MS=2000
